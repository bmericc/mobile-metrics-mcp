# Settings for docs/docker-compose.yml. Copy to .env next to the compose file and fill in.

# Shown as the logo text and in page titles.
APP_NAME="Mobile Metrics MCP"
APP_ENV=production
APP_DEBUG=false
# Generate once and never change it: stored store credentials are encrypted with it.
#   docker run --rm ghcr.io/bmericc/mobile-metrics-mcp:1 php artisan key:generate --show
APP_KEY=
# Public address of the app, without a trailing slash. OAuth callbacks are built from it.
APP_URL=https://metrics.example.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=metrics
DB_USERNAME=metrics
DB_PASSWORD=change-me

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Sign-in providers. There are no passwords: set up at least one provider.
# A provider left empty is hidden on the login page.
# Callback URLs: {APP_URL}/auth/google/callback, {APP_URL}/auth/apple/callback, {APP_URL}/auth/huawei/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Path of the Sign in with Apple .p8 key inside the container, e.g. /app/storage/apple-signin.p8
APPLE_PRIVATE_KEY=

HUAWEI_CLIENT_ID=
HUAWEI_CLIENT_SECRET=
