FROM composer:2@sha256:0c8e663f14c94d07b3c45b175c51f5a14718508f21fe4dd7e54f09488dd0ed71 AS composer

FROM php:8.5-fpm@sha256:baf3ea13a8207fa18e1011bad1016e8b5e59fc974c6966d0efa6f36a16f875f0

RUN apt-get update && apt-get install -y \
    libonig-dev libxml2-dev libzip-dev libicu-dev \
    zip unzip curl git \
    && docker-php-ext-install \
        pdo_mysql mbstring pcntl bcmath zip intl \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY --from=composer /usr/bin/composer /usr/local/bin/composer

WORKDIR /var/www/html
