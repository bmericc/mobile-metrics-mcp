# docker compose değişkenleri. Gerçek değerleri `deploy/.env` içine koy (git'e girmez).
#   cp deploy/.env.example deploy/.env  && düzenle

COMPOSE_PROJECT_NAME=kalehost-metrics

MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=metrics_db
MYSQL_USER=metrics_user
MYSQL_PASSWORD=change-me

# nginx'in host'ta dinleyeceği adres:port.
NGINX_BIND=127.0.0.1:8081
